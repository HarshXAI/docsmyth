{
  "name": "@acp/hub",
  "version": "0.1.1-rc.0",
  "description": "API Contract Platform Hub - Central contract storage and serving service",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/api-contract-platform.git",
    "directory": "packages/hub"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "acp-hub": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "node --loader ts-node/esm src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@acp/ir-spec": "workspace:*",
    "@acp/compiler-openapi": "workspace:*",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "vitest": "^2.1.8"
  }
}
