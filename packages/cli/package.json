{
  "name": "@acp/cli",
  "version": "0.1.1-rc.0",
  "description": "API Contract Platform CLI - Manage and compile API contracts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/api-contract-platform.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "acp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm -w turbo run build --filter=@acp/cli..."
  },
  "dependencies": {
    "@acp/ir-spec": "workspace:*",
    "@acp/ir-sdk": "workspace:*",
    "@acp/compiler-openapi": "workspace:*",
    "@acp/evidence-sdk": "workspace:*",
    "@acp/linter": "workspace:*",
    "@acp/capture-proxy": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
