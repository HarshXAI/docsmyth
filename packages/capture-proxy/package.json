{
  "name": "@docsmyth/capture-proxy",
  "version": "0.2.0-rc.8",
  "description": "API Contract Platform Capture Proxy - Language-agnostic HTTP sidecar for evidence capture",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarshXAI/docsmyth.git",
    "directory": "packages/capture-proxy"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@docsmyth/evidence-sdk": "workspace:*",
    "@docsmyth/hub-client": "workspace:*",
    "@docsmyth/ir-spec": "workspace:*",
    "@docsmyth/path-matcher": "workspace:*",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.15",
    "vitest": "^2.1.8"
  }
}
