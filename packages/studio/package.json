{
  "name": "@docsmyth/studio",
  "version": "0.2.0-rc.9",
  "description": "Docsmyth Studio - A first-class UI for API contract exploration and evidence visualization",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarshXAI/docsmyth.git",
    "directory": "packages/studio"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "docsmyth-studio": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build:web && pnpm build:server",
    "build:server": "tsc -b",
    "build:web": "cd web && pnpm build",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@docsmyth/compiler-openapi": "0.1.1-rc.7",
    "@docsmyth/evidence-sdk": "0.1.1-rc.7",
    "@docsmyth/ir-sdk": "0.1.1-rc.7",
    "@docsmyth/ir-spec": "0.1.1-rc.7",
    "@fastify/static": "^8.0.4",
    "@fastify/cors": "^10.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "fastify": "^5.2.1",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "vitest": "^2.1.8"
  }
}
